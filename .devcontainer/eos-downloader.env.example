# Runtime-only environment variables for eos-downloader.
#
# Copy this file to .devcontainer/eos-downloader.env, replace the placeholder
# values, and rebuild or reopen the devcontainer.
#
# The devcontainer loads .devcontainer/eos-downloader.env with Docker's
# --env-file support, so this file uses plain KEY=VALUE lines.

ARISTA_TOKEN=replace-with-your-arista-token
ARISTA_GET_EOS_FORMAT=cEOS
ARISTA_GET_EOS_OUTPUT=/workspaces/arista/images
ARISTA_GET_EOS_VERSION=4.34.6M
ARISTA_GET_EOS_BRANCH=4.34
ARISTA_GET_EOS_EVE_NG=false
ARISTA_GET_EOS_DOCKER_NAME=ceos
ARISTA_GET_EOS_DOCKER_TAG=4.34.6m
ARISTA_GET_EOS_RELEASE_TYPE=M
ARISTA_GET_CVP_FORMAT=kvm
ARISTA_GET_CVP_OUTPUT=/workspaces/arista/images
ARISTA_GET_CVP_LATEST=false
ARISTA_GET_CVP_VERSION=2025.1.0
ARISTA_GET_CVP_BRANCH=2025.1
